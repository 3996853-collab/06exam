<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <title>HBuilderX-高效极客技巧</title>
        <link href="//ask.dcloud.net.cn/static/css/classblack/img/favicon.png?v=20141207" rel="shortcut icon" type="image/x-icon">
        <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no" />
        <meta name="keywords" content="HBuilderX,快应用,流应用,mui,nativejs,dcloud,HBuilder,HTML5,数字天堂网络,数字天堂,web,前端开发,web开发,跨平台,app开发,公众号,开发工具,ide,css,vue,javascript,dreamweaver,dw,sublime,brackets,vs,code,eclipse,webstorm,visual studio,editplus,notepad++,数字天堂（北京）网络技术有限公司">
        <meta name="description" content="HBuilderX是当前最快的HTML开发工具，强大的代码助手帮你快速完成开发，最全的语法库和浏览器兼容性数据让浏览器碎片化不再头痛">
        <link rel="stylesheet" type="text/css" href="css/hbuilderx_new.css?v=20250623" />
        <link rel="stylesheet" type="text/css" href="css/fonticon.css?v=0923">
        <script src="js/lang.js?t=20250106" type="text/javascript" charset="utf-8"></script>
        <script src="js/vue.js?t=20210817" type="text/javascript" charset="utf-8"></script>
    </head>
    <body class="hx">
        <div id="app" v-cloak>
            <!-- page-header -->
            <div class="header head-msg" v-bind:class="{hidden : language != 'zh'}">
                <ul class="mui-pull-right mui-list-inline">
                    <li>
                        <a class="weixin-toggle"><i class="icon-weixin"></i>
                            <div class="pop-modal"><img src="//dcloud.io/img/weixin.jpg"></div>
                        </a>
                        <div class="pop-modal"> <img src="//dcloud.io/img/weixin.jpg"> </div>
                    </li>
                    <li>
                        <a href="//weibo.com/u/3196963860" target="_blank" class="weibo"><i class="icon-weibo"></i></a>
                    </li>
                    <li><i class="icon-message"></i>
                        <div id="notice">
                            <a href="//dcloud.io/150914/index.html?t=1523879749232" target="_blank" class="notice-open">法院判决APICloud赔付DCloud共计184.48万元并公开道歉</a>
                            <a href="//dcloud.io/hr/" target="_blank" class="notice-open">DCloud招人啦，工程师、运营快到碗里来</a>
                            <a href="//ask.dcloud.net.cn/article/986" target="_blank" class="notice-open">HTML5中国产业联盟正式挂靠于工信部</a>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="header mobile-header">
                <ul class="dcloud-logo mui-pull-left mui-list-inline">
                    <li> <a href="/index.html" class="hb-logo"></a> </li>
                </ul>
                <ul class="mobile-nav mui-pull-right mui-list-inline">
                    <li> <a href="index.html" target="_blank">{{LangData.nav.home.n}}</a> </li>
                    <li> <a href="//hx.dcloud.net.cn" target="_blank">{{ LangData.nav.hxDoc.n }}</a> </li>
                    <li> <a href="//hx.dcloud.net.cn/ExtensionTutorial/README" target="_blank">{{ LangData.nav.pDoc.n }}</a> </li>
                    <li> <a :href="AskURL" target="_blank">{{ LangData.nav.ask.n }}</a> </li>
                    <li v-if="language == 'zh'"> <a href="//www.html5plus.org/" target="_blank">{{ LangData.nav.al.n }}</a> </li>
                    <li v-if="language == 'zh'"> <a href="//dcloud.io/case/" target="_blank">{{ LangData.nav.case.n }}</a> </li>
                    <li class="item-dev" v-if="language == 'zh'"> <a href="//dev.dcloud.net.cn/sponsor/" target="_blank">{{ LangData.nav.sponsor.n }}</a> </li>
                    <li class="item-dev" v-if="language == 'zh'"> <a href="//dev.dcloud.net.cn/wish/" target="_blank">{{ LangData.nav.dw.n }}</a> </li>
                    <li class="item-dev dropdown">
                        <div style="display: flex;">
                            <span>{{ LangData.nav.lang.n }}</span>
                             <img :src="iconSrc('icon/icon_down_arrow.svg')" style="margin-top: -30px;" />
                        </div>
                        <div class="dropdown-content">
                            <p @click="setLang('zh')" v-bind:class="{ clickDisabled: language == 'zh' }">简体中文</p>
                            <p @click="setLang('en')" v-bind:class="{ clickDisabled: language == 'en' }">English</p>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- logo and download button -->
            <div class="menu">
                <div class="hx-title">
                    <img :src="iconSrc('icon/hbuilderx_icon@2x.png')" />
                    <span class="text-for-hbuilderx ">HBuilder X</span>
                    <span class="text-for-hbuilderx-desc">{{ language == 'zh' ? '为极客、为懒人、为你' : 'a superpowered IDE for Vue' }}</span>
                </div>

                <!-- 2022-04-21 电脑 UI -->
                <div class="download-hx download-hx-en" id="download-hx-en" style="margin-bottom: 1.5rem; margin-top: 1.5rem;"
                    @mouseleave="en_download_matrix=false" v-if="isPc">
                    <div class="en-text">
                        <a title="Download HBuilderX" :href="default_download_url" @click="googleEvent()">
                            {{ default_download_display_text }}
                        </a>
                    </div>
                    <div class="split-line"></div>
                    <div class="en-icon" @mouseenter="en_download_matrix=true">
                        <span class="more">more</span>
                        <span id="more_icon" class="more_icon" :class="[en_download_matrix ? 'up_arrow': 'down_arrow']"></span>
                    </div>
                    <div id="download-matrix" class="download-matrix"
                        :class="{'zh-download-matrix': language == 'zh'}"
                        v-show="en_download_matrix"
                        @mouseleave="en_download_matrix=false">
                        <table>
                            <tr>
                                <th class="t-w30"></th>
                                <th class="t-w35">{{ LangData.release }} <span class="version_tag">{{ ReleaseCfg.displayVersion }}</span></th>
                                <th class="t-w35">{{ LangData.alpha }} <span class="version_tag">{{ AlphaCfg.displayVersion }}</span></th>
                            </tr>
                            <tr>
                                <td class="os t-w30">
                                    <img class="os-icon" :src="iconSrc('icon/win-icon.png')" /> Windows
                                </td>
                                <td class="t-w35">
                                    <a download :href="ReleaseCfg.win_simple.path" @click="googleEvent()"  class="download_icon">.zip</a>
                                </td>
                                <td class="t-w35">
                                    <a download :href="AlphaCfg.win_simple.path" @click="googleEvent()" class="download_icon">.zip</a>
                                </td>
                            </tr>
                            <tr class="tr-line">
                                <td class="os t-w30">
                                    <img class="os-icon" :src="iconSrc('icon/mac-icon.png')" /> Mac Intel
                                </td>
                                <td class="t-w35">
                                    <a download :href="ReleaseCfg.mac_simple.path" @click="googleEvent()" class="download_icon">.dmg</a>
                                </td>
                                <td class="t-w35">
                                    <a download :href="AlphaCfg.mac_simple.path" @click="googleEvent()" class="download_icon">.dmg</a>
                                </td>
                            </tr>
                            <tr class="tr-line">
                                <td class="os t-w30">
                                    <img class="os-icon" :src="iconSrc('icon/mac-icon.png')" /> Mac Arm
                                </td>
                                <td class="t-w35">
                                    <div v-show="ReleaseCfg?.mac_simple_arm64?.path">
                                        <a download class="download_icon"
                                            :href="ReleaseCfg?.mac_simple_arm64?.path" @click="googleEvent()">.dmg</a>
                                    </div>
                                </td>
                                <td class="t-w35">
                                    <div v-show="AlphaCfg?.mac_simple_arm64?.path">
                                        <a download class="download_icon" :href="AlphaCfg?.mac_simple_arm64?.path" @click="googleEvent()">.dmg</a>
                                    </div>
                                </td>
                            </tr>
                            <tr class="tr-line">
                                <td class="os t-w30">
                                    <img class="os-icon" :src="iconSrc('icon/linux-icon.png')" /> Linux x64
                                </td>
                                <td class="t-w35">
                                    <div v-show="ReleaseCfg?.linux_full_x64?.path">
                                        <!-- <a download class="download_icon" :href="ReleaseCfg?.linux_full_x64?.path" @click="googleEvent()">.tar.gz</a> -->
                                        <a class="download_icon" :href="linux_url" target="_blank" @click="googleEvent()">.tar.gz</a>
                                    </div>
                                </td>
                                <td class="t-w35">
                                    <div v-show="AlphaCfg?.linux_full_x64?.path">
                                        <!-- <a download class="download_icon" :href="AlphaCfg?.linux_full_x64?.path" @click="googleEvent()">.tar.gz</a> -->
                                        <a class="download_icon" :href="linux_url" target="_blank" @click="googleEvent()">.tar.gz</a>
                                    </div>
                                </td>
                            </tr>
                            <tr class="tr-line">
                                <td class="t-w30"></td>
                                <td class="t-w35">
                                    <a target="_blank" :href="ReleaseCfg.changeLog">
                                        <img :src="iconSrc('icon/info.png')" class="os-img-icon"/>{{ LangData.ReleaseNote }}
                                    </a>
                                </td>
                                <td class="t-w35">
                                    <a target="_blank" :href="AlphaCfg.changeLog">
                                        <img :src="iconSrc('icon/info.png')" class="os-img-icon"/>{{ LangData.ReleaseNote }}
                                    </a>
                                </td>
                            </tr>
                        </table>
                        <div v-if="language == 'zh'">
                            <p class="pkg-tip">
                                <span>PS：标准版也可安装app开发插件</span>
                                <a href="https://ask.dcloud.net.cn/article/35765" target="_Blank" style="color: #348e43; padding: 0 10px;">版本区别说明</a>
                                <a href="https://hx.dcloud.net.cn/Tutorial/HistoryVersion" target="_Blank" style="color: #348e43;">历史版本</a>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 手机弹窗 -->
                <div class="download-hx download-hx-cn" id="download-hx" style="margin-bottom: 1.5rem;margin-top: 1.5rem;" v-else>
                    <a download title="下载HBuilderX" @click="openDownloadBoxForMobile();">DOWNLOAD</a>
                </div>
            </div>

            <!--page-animate-->
            <div id="page-hx-animate" class="animate">
                <div style="position: relative;">
                    <div id="ani-layer" class="ani-layer" style="display: block;">
                        <p id="ani-layer-text"></p>
                    </div>
                    <div id="animate-main" class="animate-main">
                        <!--搜索条-->
                        <div id="animate-toolbar" class="animate-header"></div>
                        <div class="animate-content">
                            <!--项目管理区域-->
                            <div id="animate-side" class="animate-side"></div>
                            <!--顶部选项卡部分-->
                            <!-- <nav class="animate-nav"></nav> -->
                            <!--动画内容-->
                            <div id="animate-canvas-content" class="animate-canvas">
                                <canvas id="animate-canvas"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!--底部条-->
                <div class="animate-footer">
                    <div id="hotkey-desc" class="hotkey-desc"></div>
                    <div class="control on" id="animate-control"></div>
                </div>

                <!-- 底部切换 -->
                <div class="animate-footer-tab text-center">
                    <a class="nav-item a-switch active" href="javascript:;" title="绿柔主题: 秒开大文件"></a>
                    <a class="nav-item a-switch" href="javascript:;" title="雅蓝主题: 强大的Vue支持"></a>
                    <a class="nav-item a-switch" href="javascript:;" title="酷黑主题: 智能双击与包围"></a>
                    <div class="display-inline" style="margin-left: 30px;">
                        <a class="more-skil-text"
                            href="https://hx.dcloud.net.cn/Tutorial/UserGuide/skill" target="_blank">{{ LangData.MoreSkill }} &#62;&#62;</a>
                    </div>
                </div>
            </div>

            <!-- page-body-shadow -->
            <div class="page-shadow">
                <span></span>
            </div>

            <!-- page-hx-desc-img -->
