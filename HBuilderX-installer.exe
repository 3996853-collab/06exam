                <div class="text-center hx-desc" v-if="language == 'zh'">
                    <img :src="iconSrc('website/en/hx_desc@1x.png')" :srcset="iconSrc('website/en/hx_desc@2x.png', true)" />
                </div>
                <div class="text-center hx-desc-en" v-else>
                    HBuilder - Fast, Light, Powerful, Free
                </div>
            </div>

            <!-- page-hx-desc-text -->
            <div id="page-hx-desc-text"  class="hx-container hx-board-c">
                <div class="tip-list">
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_1@1x.png')" :srcset="iconSrc('/website/en/tip/hx_tip_icon_1@1x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.intro.title }}</dt>
                            <dd> <p v-html="LangData.body.intro.desc"></p> </dd>
                        </dl>
                    </div>
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_2@1x.png')" :srcset="iconSrc('website/en/tip/hx_tip_icon_2@2x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.Intellisense.title }}</dt>
                            <dd> <p v-html="LangData.body.Intellisense.desc"></p> </dd>
                        </dl>
                        <a href="https://hx.dcloud.net.cn/Tutorial/Language/Overview" target="_blank">{{ LangData.details }}&gt;</a>
                    </div>
                </div>
                <div class="tip-list">
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_3@1x.png')" :srcset="iconSrc('website/en/tip/hx_tip_icon_3@2x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.vue.title }}</dt>
                            <dd> <p v-html="LangData.body.vue.desc"></p> </dd>
                        </dl>
                        <a href="https://hx.dcloud.net.cn/Tutorial/Language/vue" target="_blank">{{ LangData.details }}&gt;</a>
                    </div>
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_4@1x.png')" :srcset="iconSrc('website/en/tip/hx_tip_icon_4@2x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.UI.title }}</dt>
                            <dd> <p v-html="LangData.body.UI.desc"></p> </dd>
                        </dl>
                        <a href="https://hx.dcloud.net.cn/Tutorial/Other/health" target="_blank">{{ LangData.details }}&gt;</a>
                    </div>
                </div>
                <div class="tip-list">
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_5@1x.png')" :srcset="iconSrc('website/en/tip/hx_tip_icon_5@2x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.Geek.title }}</dt>
                            <dd> <p v-html="LangData.body.Geek.desc"></p> </dd>
                        </dl>
                        <a :href="LangData.body.Geek.url" target="_blank" v-show="LangData.body.Geek.url">{{ LangData.details }}&gt;</a>
                    </div>
                    <div class="tip-item">
                        <img class="tip-icon" :src="iconSrc('website/en/tip/hx_tip_icon_6@1x.png')" :srcset="iconSrc('website/en/tip/hx_tip_icon_6@2x.png', true)" />
                        <dl>
                            <dt>{{ LangData.body.md.title }}</dt>
                            <dd> <p v-html="LangData.body.md.desc"></p> </dd>
                        </dl>
                        <a href="//hx.dcloud.net.cn/Tutorial/Language/markdown" target="_blank">{{ LangData.details }}&gt;</a>
                    </div>
                </div>
            </div>

            <div class="clear"></div>

            <!-- footer -->
            <div id="page-footer" class="hx-footer">
                <img class="logo" :src="iconSrc('website/en/icon/hx_icon@1x.png')" :srcset="iconSrc('website/en/icon/hx_icon@2x.png', true)" />
                <p class="copyright">
                    <a class="home" href="//www.dcloud.io">©DCloud.io</a>
                </p>
            </div>

            <!-- 下载mask: 手机浏览器弹窗-->
            <div id="download-mask" class="mask" :class="[isShowBoxForMobile ? 'display-block' : 'display-no']">
                <div id="download-dialog-phone" name="dialog-mobile" class="download-modal" style="padding-top: 50px;" :class="{'display-no': isPc}">
                    <span class="close icon-close" @click="isShowBoxForMobile = false"></span>
                    <div id="mobile-hx-logo" class="text-center">
                        <img class="logo" :src="iconSrc('mobile/hx_icon@1x.png')" :srcset="iconSrc('mobile/hx_icon@2x.png', true)" />
                    </div>
                    <div id="mobile-hx-release-version" class="mobile-hx-version">
                        <span class="version-text">{{ LangData.release }}
                            <span class="version-code" id="phone-version-hock">{{ ReleaseCfg.displayVersion }}</span>
                        </span>
                        <a id="mobile-hx-changelog" class="version-changelog float-right"
                            :href="ReleaseCfg.changeLog" target="_blank">{{ LangData.ReleaseNote }}&#62;</a>
                    </div>
                    <div class="cut-line"></div>
                    <div id="mobile-hx-alpha-version" class="mobile-hx-version">
                        <span class="version-text">{{ LangData.alpha }}
                            <span class="version-code" id="phone-version-alpha-hock">{{ AlphaCfg.displayVersion }}</span>
                        </span>
                        <a id="mobile-hx-alpha-changelog" class="version-changelog float-right"
                            :href="AlphaCfg.changeLog" target="_blank">{{ LangData.ReleaseNote }}&#62;</a>
                    </div>
                    <div class="cut-line"></div>
                    <div id="mobile-hx-download-prompt" class="mobile-hx-download-prompt">
                        <div style="margin-right: 5px;margin-top: -1px;">
                            <img :src="iconSrc('mobile/mobile-hx-prompt.png')" :srcset="iconSrc('mobile/mobile-hx-prompt@2x.png', true)" />
                        </div>
                        <div class="prompt-text">
                            <span>HBuilderX是PC桌面软件，手机端不支持下载，请打开电脑浏览器进行下载。</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="//js.cdn.aliyun.dcloud.net.cn/dev/js/jquery-2.1.0.js" type="text/javascript" charset="utf-8"></script>
        <!-- <script src="miku-delivery-1.2.1.js" type="text/javascript" charset="utf-8"></script> -->
        <script src="//www.dcloud.io/miku-delivery-1.2.1.js" type="text/javascript" charset="utf-8"></script>
        <script>
            mikuDelivery.initProxy('miku-delivery-sw-1.2.1.js', {
                /** appID 和 appSalt 由七牛配置提供*/
                app: { appID: 'r5v5l8yhuips0xwv', appSalt: 'ejhqsncr0hrwcadkfrsh07n3p6wxt9q3' },
                /** 需要被代理的域名列表，域名需要提前在七牛创建完成，由七牛配置 ecdn 功能 */
                domains: ['qiniu-ecdn.dcloud.net.cn'],
                // debug: true,
                /** 开启对 <a> 标签文件下载请求的代理功能 */
                anchorDownload: true,
                patterns: {
                    other: [/\.(zip|dmg)$/]
                }
            });

            // 2021-06-16 增加通过链接直接打开下载弹窗功能，并切换到相应的版本。
            // https://www.dcloud.io/hbuilderx.html#download_alpha || https://www.dcloud.io/hbuilderx.html#download_release
            var urlHash = window.location.hash;
            var sUserAgent = navigator.userAgent.toLowerCase();

            // 2021-07-14 针对手机，优化下载弹窗样式。手机访问，点击下载，仅显示版本号和更新日志
            var isPc = true;
            if (sUserAgent.includes('mobile') || sUserAgent.toLocaleLowerCase().includes('ipad') || sUserAgent.toLocaleLowerCase().includes('android')) {
                isPc = false;
            };

            // Download按钮
            var OSName = 'windows';
            var DownLoad_Text_for_en = 'Download for Windows';
            if (sUserAgent.indexOf('mac') > -1) {
                DownLoad_Text_for_en = 'Download for Mac';
                OSName = 'mac';
                if (isAppleSilicon()) {
                    OSName = 'mac_apple_silicon';
                };
            };
            if (sUserAgent.indexOf('linux') > -1) {
                DownLoad_Text_for_en = 'Download for Linux';
                OSName = 'Linux';
            };

            // 获取浏览器语言
            var lan = navigator.systemLanguage || navigator.language;
            lan = lan.substr(0, 2) == 'zh' ? 'zh' : 'en';

            let user_set_language = getCookie('user_set_language');
            if (['en','zh'].includes(user_set_language)) {
                lan = user_set_language;
            };

            // set title
            if (lan != 'zh') {
                document.getElementsByTagName('title')[0].innerText = 'HBuilderX - a superpowered IDE for Vue';
                const desc = 'HBuilderX is the fastest HTML development tool. Powerful code assistant helps you complete development quickly. The complete syntax library and browser compatibility function will improve your development efficiency.';
                document.querySelector('meta[name="description"]').setAttribute('content', desc);
            };

            var app = new Vue({
                el: '#app',
                data: {
                    OSName: 'windows',
                    isPc: '',
                    isShowBoxForMobile: false,
                    isShowBoxForRlease: true,
                    zh_downloadURL: 'https://download1.dcloud.net.cn/hbuilderx/',
                    en_downloadURL: 'https://download.dcloud.io/hbuilderx/',
                    // en_downloadURL: "http://192.168.12.242:8848/hx官网源码/",
                    // zh_downloadURL: "http://192.168.12.242:8848/hx官网源码/",
                    language: '',
                    LangData: {},
                    linux_url: "https://hx.dcloud.net.cn/Tutorial/install/linux-cli",
                    ReleaseCfg: {
                        'win_simple':{},
                        'mac_simple': {},
                        'mac_simple_arm64': {},
                        'linux_full_x64': {},
                    },
                    AlphaCfg: {
                        'win_simple':{},
                        'mac_simple': {},
                        'mac_simple_arm64': {},
                        'linux_full_x64': {},
                    },
                    AskURL: '//ask.dcloud.net.cn/explore/',
                    // 网页默认大按钮下载文本
                    default_download_display_text: DownLoad_Text_for_en,
                    en_download_matrix: false
                },
                computed: {
                    // 网页默认大按钮下载链接
                    default_download_url() {
                        if (this.OSName == 'mac') {
                            return this.ReleaseCfg.mac_simple.path;
                        };
                        if (this.OSName == 'mac_apple_silicon') {
                            return this.ReleaseCfg.mac_simple_arm64.path;
                        };
                        if (this.OSName == 'linux') {
                            // if (this.ReleaseCfg.linux_full_x64.path) {
                            //     return this.ReleaseCfg.linux_full_x64.path;
                            // };
                            // return this.AlphaCfg.linux_full_x64.path;
                            return this.linux_url;
                        };
                        return this.ReleaseCfg.win_simple.path;
                    }
                },
                created() {
                    this.OSName = OSName;
                    this.isPc = isPc;
                    this.language = lan;
                    this.LangData = InternationalizationData[lan];
                    this.getHXDownLoadConfig("alpha");
                    this.getHXDownLoadConfig("release");

                    const timestamp = Date.now();
                    this.linux_url = this.linux_url + '?t=' + timestamp;
                },
                mounted() {
                    if (this.language != 'zh') {
                        this.AskURL = 'https://github.com/dcloudio/HBuilderX/issues';
                    };
                },
                methods: {
                    iconSrc(filename, is2x = false) {
                        const base = '//web-ext-storage.dcloud.net.cn/static/hbuilderx/';
                        return is2x ? `${base}${filename} 2x` : `${base}${filename}`;
                    },
                    // 手机上样式弹窗
                    openDownloadBoxForMobile() {
                        this.isShowBoxForMobile = true;
                    },
                    // 添加google事件
                    googleEvent() {
                        if (this.language != 'zh') {
                            gtag('event', 'ClickDownLoadBtn', {
                               'event_name': 'download-hx'
                            });
                        };
                    },
                    isShowBoxForVersion(item) {
                        this.isShowBoxForRlease = item == 'alpha' ? false : true;
                    },
                    setLang(item) {
                        this.setCookie('user_set_language', item);
                        location.reload();
                    },
                    setCookie(name, value) {
                        var Days = 365;
                        var exp = new Date();
                        exp.setTime(exp.getTime() + Days * 24 * 60 * 60 * 1000);
                        document.cookie = name + '=' + escape(value) + ';expires=' + exp.toGMTString();
                    },
                    open_en_download_matrix() {
                        if (this.en_download_matrix) {
                            this.en_download_matrix = false;
                        } else {
                            this.en_download_matrix = true;
                        }
                    },
                    // 获取HBuilderX Alpha下载配置文件
                    getHXDownLoadConfig(hx_type="release") {
                        let configFile = lan == 'zh' ? 'release.json' : 'release_en.json';
                        if (hx_type == "alpha") {
                            configFile = lan == 'zh' ? 'alpha.json' : 'alpha_en.json';
                        };
                        let downloadURL = lan == 'zh' ? this.zh_downloadURL : this.en_downloadURL;

                        let downloadConfig = {
                            "displayVersion": ""
                        };
                        let that = this;
                        $.ajax({
                            url: downloadURL + configFile + '?timestamp=' + $.now(),
                            dataType: 'json',
                            success: function(data) {
                                // hbuilderx release version
                                if (data.displayVersion) {
                                    downloadConfig['displayVersion'] = "v"+data.displayVersion;
                                };
                                downloadConfig['version'] = data.version;
                                downloadConfig['changeLog'] = data.release;

                                // download info
                                for (let i of data.files) {
                                    let code = i.code;
                                    i.path = i.path.replace('download1.dcloud.net.cn', 'qiniu-ecdn.dcloud.net.cn');
                                    if (code == 'win_simple') {downloadConfig.win_simple = i;};
                                    if (code == 'win_full') {downloadConfig.win_full = i;};
                                    if (code == 'mac_simple') {downloadConfig.mac_simple = i;};
                                    if (code == 'mac_simple_arm64') {downloadConfig.mac_simple_arm64 = i;};
                                    if (code == 'linux_full_x64') {downloadConfig.linux_full_x64 = i;};
                                    if (code == 'mac_full') {downloadConfig.mac_full = i;};
                                };
                                if (hx_type == "alpha") {
                                    that.AlphaCfg = downloadConfig;
                                } else {
                                    that.ReleaseCfg = downloadConfig;
                                };
                            },
                            error: function(err) {
                                console.log('错误：获取不到Alpha版下载配置文件信息，因此无法显示下载链接。');
                            }
                        });
                    }
                }
            });

            // 2021-09-02: google分析，仅对非中文环境生效
            if (lan != 'zh') {
                var script1=document.createElement('script');
                script1.src='https://www.googletagmanager.com/gtag/js?id=G-H78DWGLM17';
                var script2=document.createElement('script');
                script2.innerText='window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag(\'js\', new Date());gtag(\'config\', \'G-H78DWGLM17\');';
                document.head.append(script1);
                document.head.append(script2);
            };

            // 2021-09-03: baidu统计
            if (lan == 'zh') {
                var _hmt = _hmt || [];
                var hm = document.createElement('script');
                hm.src = '//hm.baidu.com/hm.js?16bea9b124e2f593705dfb2997ff87db';
                var s = document.getElementsByTagName('script')[0];
                s.parentNode.insertBefore(hm, s);
                // 来源统计
                var source = document.referrer;
                $(document).on('click', '.statistics-hock', function() {
                    var edition = $(this).attr('data-source');
                    var type = $(this).attr('data-type');
                    if (source) {
                        type += '?=' + source;
                    };
                    _hmt.push(['_trackEvent', edition, 'download', type]);
                });
            };

            // 判断Mac电脑芯片
            function isAppleSilicon() {
                try {
                    const canvas = document.createElement('canvas');
                    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
                    if (!gl) return false;

                    const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
                    if (!debugInfo) return false;

                    const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
                    if (renderer && !renderer.includes("Intel")) return true;
                } catch (error) {}
                return false;
            };

            //获取指定名称的cookie的值
            function getCookie(name) {
                let arr,reg=new RegExp('(^| )'+name+'=([^;]*)(;|$)');
                if(arr=document.cookie.match(reg)) {
                    return unescape(arr[2]);
                } else {
                    return null;
                };
            };
        </script>

        <script src="js/hbuilderx.js?t=2025042301" type="text/javascript" charset="utf-8"></script>
        <!-- 统计 -->
        <script>
            var load = true;
            (function() {
                var weixin = document.querySelector('.weixin-toggle'),
                    pop = document.querySelector('.pop-modal');
                weixin.addEventListener('click', function() {
                    weixin.classList.add('open');
                });
                pop.addEventListener('click', function(e) {
                    weixin.classList.remove('open');
                    e.stopPropagation();
                    e.preventDefault();
                });
            })();

            // 公告轮播
            var notice = document.getElementById('notice');
            notice.innerHTML += notice.innerHTML;
            var a = setTimeout(setScroll, 5000);
            var num = 0;

            function setScroll() {
                if (num % 18 === 0) {
                    var x = setInterval(function() {
                        num++, notice.scrollTop = num;
                        if (num % 18 === 0) {
                            if (notice.scrollHeight / 2 === num) {
                                notice.scrollTop = 0;
                                num = 0;
                            }
                            clearInterval(x);
                            a = setTimeout(setScroll, 5000);
                        }
                    }, 10);
                };
            };
            notice.onmouseover = function() {
                clearTimeout(a);
            };
            notice.onmouseout = function() {
                a = setTimeout(setScroll, 5000);
            };
        </script>
    </body>

</html>
