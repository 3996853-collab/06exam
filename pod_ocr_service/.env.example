# ==========================================
# POD OCR Service 环境变量配置示例
# ==========================================

# 服务基础配置
APP_NAME=POD-OCR-Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 数据库配置 (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ztobase_db
DB_ECHO=false

# 视觉大模型 (VLM) API 配置 (兼容 OpenAI / DashScope)
# DashScope 示例:
# VLM_API_KEY=sk-xxxx
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL_NAME=qwen-vl-max
VLM_API_KEY=your-vlm-api-key-here
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_NAME=qwen-vl-max
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=2

# 并发线程数
MAX_CONCURRENT_WORKERS=5

# 存储类型: local (本地及测试), oss (阿里云OSS), cos (腾讯云COS), mock (纯模拟存证)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage_uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/storage

# 阿里云 OSS (当 STORAGE_TYPE=oss 时使用)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=pod-receipts
